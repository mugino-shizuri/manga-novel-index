{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/plugin.schema.json",
  "title": "插件声明（plugins/<id>/plugin.json）",
  "description": "内容插件的最小声明；插件系统只在构建期加载。",
  "$comment": "由 kernel/emit_contracts.py 从 kernel/schema.py 生成，请勿手改。JSON Schema 只描述形状；record_prefix 必须全局唯一且一经发布不得更改（构建期由 V3 检查），这一条无法在本文件中表达。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilities",
    "data",
    "id",
    "name",
    "plugin_api",
    "record_prefix",
    "schema",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "plugin_api": {
      "const": "1.0"
    },
    "record_prefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,15}$"
    },
    "data": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "work.read",
          "work.list"
        ]
      }
    }
  }
}
