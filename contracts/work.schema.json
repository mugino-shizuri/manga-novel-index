{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/work.schema.json",
  "title": "作品记录（plugins/<id>/data/works.jsonl 的一行）",
  "description": "所有内容插件共用的记录形状。插件 schema.json 只能收窄，不能新增与通用契约冲突的字段。",
  "$comment": "由 kernel/emit_contracts.py 从 kernel/schema.py 生成，请勿手改。JSON Schema 只描述形状；以下语义无法表达，仍在 schema.py 与 README 中定义：(1) id 的前缀必须逐字等于所属插件 plugin.json 的 record_prefix，且插件间前缀不得重复；(2) 作品号在单个数据文件内唯一，删除后不得复用；(3) part 缺失表示正篇，缺省值以 capabilities.json 的 defaults.part 为准；(4) 同一作品的分组键由 id 按 '-' 分割取前两段得到，禁止用固定字符偏移；(5) 同一记录内 titles[].value 不得重复，creators[].aliases 不得与 name 相同。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "titles",
    "creators",
    "progress",
    "tags",
    "synopsis",
    "sources",
    "created"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{2,15}-\\d{6}-\\d{2}$",
      "description": "<前缀>-<6位作品号>-<2位系列号>；前缀由记录自身的插件决定"
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "ja",
              "ja_romaji",
              "zh",
              "zh_alias",
              "en"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "name"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "推荐值见 README 的 creators[].role 表；自由文本，偏离仅警告"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "繁简/日文汉字等异体写法，用于索引展开"
          }
        }
      }
    },
    "status": {
      "enum": [
        "连载中",
        "已完结",
        "休载",
        "腰斩",
        null
      ]
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "part": {
      "type": "string",
      "minLength": 1
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "volume": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "chapter"
          ]
        },
        {
          "required": [
            "volume"
          ]
        }
      ],
      "description": "chapter 与 volume 至少一个；不能假定两者同时存在"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "synopsis": {
      "type": "string",
      "description": "可为空字符串；空字符串表示未撰写"
    },
    "started": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "ended": {
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "aggregator",
              "official",
              "other"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
          }
        }
      },
      "description": "首条为主源"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
